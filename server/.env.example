MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/irontrack
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AUTH_REFRESH_SECRET=use-a-different-random-secret-of-at-least-32-bytes
PORT=4001
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SINGLE_USER_MODE=false
SINGLE_USER_NAME=IronTrack Owner
LOG_LEVEL=debug
# Set to 1 when deployed behind a single trusted reverse proxy (for example Render).
TRUST_PROXY=
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=generate-a-vapid-key-pair
VAPID_PRIVATE_KEY=keep-this-secret
