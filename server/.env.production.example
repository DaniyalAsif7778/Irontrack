# Copy these entries into the backend host's private environment settings.
# For local use, copy this file to server/.env and replace every placeholder.
# Never commit real credentials or expose them as VITE_ frontend variables.

NODE_ENV=production
# Keep 4000 if the service host does not provide PORT; otherwise use its assigned port.
PORT=4000

MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster>/<database-name>
AUTH_JWT_SECRET=<unique-random-secret-at-least-32-bytes>
AUTH_REFRESH_SECRET=<different-unique-random-secret-at-least-32-bytes>

# Use the exact app origin. Add more exact origins comma-separated if required.
# Do not use the marketing website URL or a wildcard origin.
CLIENT_ORIGIN=https://irontrack-nu.vercel.app
CLIENT_URL=https://irontrack-nu.vercel.app

# Nodemailer Gmail credentials. EMAIL_PASS is a Google App Password, not the account password.
EMAIL_USER=<your-sending-gmail-address>
EMAIL_PASS=<google-app-password>

LOG_LEVEL=info
MONGO_SLOW_QUERY_MS=250

# Optional: enable PostHog notification monitoring. The API starts without these values.
# Use a project ingest key, never a personal API key. Keep it in server-only environment settings.
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PROJECT_API_KEY=<project-ingest-key>

# Set only to the trusted proxy hop count documented by your API host.
# Leave empty until that value is confirmed.
TRUST_PROXY=

# Optional: configure these only if you have generated VAPID keys for push notifications.
# VAPID_SUBJECT=mailto:<your-contact-email>
# VAPID_PUBLIC_KEY=<your-vapid-public-key>
# VAPID_PRIVATE_KEY=<your-vapid-private-key>
